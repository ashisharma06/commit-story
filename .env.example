# Optional: raises the GitHub API rate limit from 60 to 5,000 requests/hour.
GITHUB_TOKEN=

# Optional: Upstash Redis REST credentials. When omitted, local dev runs with
# no cache and in-memory rate limiters.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Public canonical URL used for metadata, sitemap, robots, and badge snippets.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only Google Generative AI key used by POST /api/story.
GOOGLE_GENERATIVE_AI_API_KEY=

# Google model id used by POST /api/story. Defaults to gemini-2.5-flash.
AI_MODEL=gemini-2.5-flash
